  m_TableData:
  - m_Id: 104712649871360
    m_Localized: "\u0411\u0443\u0442, \u0442\u044B \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 104743104712704
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043A\u043E\u043B\u043E\u043D\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 105169027895296
    m_Localized: "\u0411\u0443\u0442, \u0442\u044B \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 105177936596992
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043A\u043E\u043B\u043E\u043D\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 118068689539072
    m_Localized: "\u0410, \u0432\u043E\u0442 \u0438 \u043E\u043D\u0438, \u043A\u0430\u043A
      \u0440\u0430\u0437 \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 118471493718016
    m_Localized: "\u041A \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C. \u0420\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C
      \u0441 \u043D\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 118646492663808
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u043F\u0430\u0442\u0440\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 119030468612096
    m_Localized: "\u041F\u0440\u0438\u0433\u043D\u0438\u0441\u044C! \u041F\u043E\u0434\u0441\u043B\u0443\u0448\u0430\u0439,
      \u043E \u0447\u0435\u043C \u043E\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0443 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 119835737231360
    m_Localized: "\u041F\u043E\u0434\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 120281717575680
    m_Localized: "\u0412\u0441\u0435 \u0432\u0441\u0442\u0430\u043B\u043E \u043D\u0430
      \u0441\u0432\u043E\u0438 \u043C\u0435\u0441\u0442\u0430. \u0420\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C
      \u0441 \u043D\u0438\u043C\u0438, \u0430 \u043F\u043E\u0441\u043B\u0435 \u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 120499167072256
    m_Localized: "\u0420\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C \u0441 \u043D\u0438\u043C\u0438,
      \u0430 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438,
      \u0447\u0442\u043E \u0432 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 120765144666112
    m_Localized: "\u0410\u0433\u0430. \u041E\u043D\u0438 \u0441\u043A\u043B\u0430\u0434\u0438\u0440\u0443\u044E\u0442
      \u0433\u0440\u0443\u0437 \u0432 \u0431\u043E\u043B\u044C\u0448\u043E\u043C
      \u0430\u043D\u0433\u0430\u0440\u0435. \u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0438
      \u0432 \u043D\u0435\u0433\u043E \u0438 \u043D\u0430\u0439\u0434\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 120958397222912
    m_Localized: "\u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u044C \u0432
      \u0430\u043D\u0433\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 121193257275392
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0430\u043D\u0433\u0430\u0440 - \u0442\u0432\u043E\u044F \u0446\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 121560346955776
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E \u0432\u043E\u0442 \u0438
      \u043A\u043B\u044E\u0447. \u041D\u0443\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0430\u043D\u0433\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 121812156190720
    m_Localized: "\u041A\u043B\u044E\u0447 \u043E\u0442 \u0430\u043D\u0433\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 123662838304768
    m_Localized: "\u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 125434906578944
    m_Localized: "\u0427\u0435\u0440\u0442. \u0417\u0430\u0440\u0430\u0437\u0430.
      \u0417\u0430\u043A\u0440\u044B\u0442\u043E, \u043D\u0443\u0436\u043D\u043E
      \u043D\u0430\u0439\u0442\u0438 \u043A\u043B\u044E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 125581401034752
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043A\u043B\u044E\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 126758452760576
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0442\u044B \u043E\u0442\u043A\u0440\u044B\u043B
      \u0434\u0432\u0435\u0440\u044C, \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 127626568830976
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438 \u0430\u043D\u0433\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 133907417436160
    m_Localized: "\u0412\u044B \u043F\u043E\u0433\u0438\u0431\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 138581495287808
    m_Localized: "\u041D\u0430\u0436\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 138779835535360
    m_Localized: "\u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u0422\u042C
      \u0427\u0422\u041E\u0411\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 138906545459200
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 373388921835520
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 373632250187776
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0433\u0440\u0443\u043F\u043F\u0430 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B\u0430
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E, \u0447\u0442\u043E
      \u0432 \u043E\u0434\u0438\u043D \u0438\u0437 \u043B\u0430\u0433\u0435\u0440\u0435\u0439
      \u0410\u043B\u043A\u0443\u0434\u044B \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u043A\u043E\u043B\u043E\u043D\u043D\u0430 \u0441 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
      \u043E\u0440\u0443\u0436\u0438\u0435\u043C. \u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u043A\u043E\u043B\u043E\u043D\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 373873162620928
    m_Localized: "\u041F\u043E\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 374631702499328
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0434\u0430\u043D\u043D\u044B\u043C,
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u043C \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u043E\u0442\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043E
      \u043F\u0440\u0438\u0431\u044B\u0432\u0430\u043D\u0438\u044F \u0433\u043B\u0430\u0432\u0430\u0440\u044F
      \u0410\u043B\u043A\u0443\u0434\u044B. \u041F\u043E\u0440\u0430 \u0441 \u043D\u0438\u043C
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 374742306295808
    m_Localized: "\u041A\u0440\u044B\u0441\u0438\u043D\u0430\u044F \u043D\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 374833352052736
    m_Localized: "\u0412\u0435\u0447\u043D\u043E \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u0412\u0441\u0435
      \u0441\u043B\u0435\u0434\u044B \u0432\u0435\u0434\u0443\u0442 \u0432 \u043E\u0434\u043D\u043E
      \u043C\u0435\u0441\u0442\u043E. \u041E\u0442\u0434\u0430\u043B\u0435\u043D\u043D\u044B\u0439
      \u043B\u0430\u0433\u0435\u0440\u044C \u0441\u0440\u0435\u0434\u0438 \u0433\u043E\u0440,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u043F\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0449\u0435
      \u0433\u043B\u0430\u0432\u044B \u0410\u043B\u043A\u0443\u0434\u044B. \u0411\u0435\u0436\u0430\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u043A\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 375483435618304
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
