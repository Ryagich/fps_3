    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u0410\u043B\u043A\u0443\u0434\u044B
      \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u043C
      \u0437\u0434\u0430\u043D\u0438\u0438 \u0441\u0432\u043E\u0435\u0433\u043E \u043B\u0430\u0433\u0435\u0440\u044F.
