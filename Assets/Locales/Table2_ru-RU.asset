  - m_Id: 534071781134336
    m_Localized: "\u0427\u0435\u0440\u0442. \u0417\u0430\u0440\u0430\u0437\u0430.
      \u041C\u043D\u0435 \u043D\u0430\u0434\u043E \u0432\u0440\u0435\u043C\u044F
      \u0432\u0437\u043B\u043E\u043C\u0430\u0442\u044C \u0432\u0435\u0440\u0442\u043E\u043B\u0435\u0442.
      \u0414\u0435\u0440\u0436\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 534290308567040
    m_Localized: "\u0412\u0435\u0440\u0442\u043E\u043B\u0435\u0442 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0430\u0448. \u0423\u0431\u0438\u0440\u0430\u0435\u043C\u0441\u044F
      \u043E\u0442\u0441\u044E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 534582836105216
    m_Localized: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C "
    m_Metadata:
      m_Items: []
  - m_Id: 534533855023104
    m_Localized: "\u043C\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 534605191745536
    m_Localized: "\u041F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C "
    m_Metadata:
      m_Items: []
  - m_Id: 538756860645376
    m_Localized: "\u043C\u0435\u0434\u0432\u0435\u0434\u044C \u0438 \u0441\u043E\u0431\u0430\u0447\u043A\u0430
      \u0421\u043D\u0435\u0436\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 538816067440640
    m_Localized: "\u041F\u043E\u0432\u0430\u0434\u0438\u043B \u043C\u0435\u0434\u0432\u0435\u0434\u044C
      \u043D\u0430 \u043F\u0430\u0441\u0435\u043A\u0443 \u043C\u0451\u0434 \u0432\u043E\u0440\u043E\u0432\u0430\u0442\u044C.
      \u043F\u0430\u0441\u0435\u0447\u043D\u0438\u043A \u0443\u0436\u0435 \u043D\u0435
      \u0437\u043D\u0430\u0435\u0442 \u0447\u0442\u043E \u0438 \u0434\u0435\u043B\u0430\u0442\u044C:
      \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0443\u0436\u044C\u0451 \u0432
      \u0440\u0443\u043A\u0438 \u0431\u0435\u0440\u0451\u0442, \u0442\u0430\u043A
      \u0441\u0440\u0430\u0437\u0443 \u043C\u0435\u0434\u0432\u0435\u0434\u044C \u043D\u0430
      \u0434\u0435\u0440\u0435\u0432\u043E \u0437\u0430\u043B\u0430\u0437\u0438\u0442,
      \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u044C.\r\n\u041D\u0443 \u0443\u0432\u0438\u0434\u0435\u043B
      \u0432 \u0433\u0430\u0437\u0435\u0442\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435:
      \u043F\u043E\u043C\u043E\u0433\u0443 \u0441 \u043B\u044E\u0431\u043E\u0439
      \u0436\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E. \u0412\u044B\u0437\u0432\u0430\u043B
      \u044D\u0442\u043E\u0433\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0430,
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u0435\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u0435\u043D\u043D\u044B\u0439 \u043C\u0443\u0436\u0438\u043A
      \u0441 \u0440\u0443\u0436\u044C\u0451\u043C \u043D\u0430\u043F\u0435\u0440\u0435\u0432\u0435\u0441
      \u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439 \u0442\u0430\u043A\u0441\u043E\u0439.\r\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0434\u0440\u0443\u0436\u043A\u0430 \u0441\u0432\u043E\u0435\u0433\u043E:\r\n\u2014
      \u042D\u0442\u043E \u0441\u043D\u0435\u0436\u043E\u043A, \u043E\u043D \u043D\u0430\u043C
      \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043C\u043E\u0436\u0435\u0442\r\n\u041D\u0443
      \u0438 \u0438\u0434\u0443\u0442 \u043D\u0430 \u043F\u0430\u0441\u0435\u043A\u0443
      \u043A \u043C\u0435\u0434\u0432\u0435\u0434\u044E, \u0430 \u0442\u043E\u0442
      \u0437\u0430\u0432\u0438\u0434\u0435\u043B \u0438\u0445 \u2014 \u0438 \u0441\u0440\u0430\u0437\u0443
      \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043E. \u041C\u0443\u0436\u0438\u043A
      \u0434\u0430\u0451\u0442 \u043F\u0430\u0441\u0435\u0447\u043D\u0438\u043A\u0443
      \u0440\u0443\u0436\u044C\u0451 \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442:\r\n\u2014
      \u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0437\u0430\u043B\u0435\u0437\u0443 \u0438 \u0441\u0431\u0440\u043E\u0448\u0443
      \u043C\u0435\u0434\u0432\u0435\u0434\u044F, \u0430\r\n\r\n\u0441\u043D\u0435\u0436\u043E\u043A
      \u0437\u0430\u043B\u0435\u0437\u0435\u0442 \u0435\u043C\u0443 \u0432 \u0436\u043E\u043F\u0443
      \u0438 \u0432\u0441\u0451 \u0440\u0430\u0437\u043E\u0440\u0432\u0451\u0442.
      \u043F\u043E\u043D\u044F\u043B?\r\n\u2014 \u041F\u043E\u043D\u044F\u043B, \u0430
      \u0440\u0443\u0436\u044C\u0451-\u0442\u043E \u0437\u0430\u0447\u0435\u043C?\r\n\u2014
      \u0415\u0441\u043B\u0438 \u044F \u0440\u0430\u043D\u044C\u0448\u0435 \u0443\u043F\u0430\u0434\u0443
      \u2014 \u0441\u0442\u0440\u0435\u043B\u044F\u0439 \u0432 \u0441\u043D\u0435\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
