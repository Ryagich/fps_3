  m_TableData:
  - m_Id: 104712649871360
    m_Localized: "Boot, neredeyse oras\u0131ndas\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 104743104712704
    m_Localized: "Konvoyu kar\u015F\u0131lamak"
    m_Metadata:
      m_Items: []
  - m_Id: 118068689539072
    m_Localized: "Ah, i\u015Fte geldiler, tam zaman\u0131nda."
    m_Metadata:
      m_Items: []
  - m_Id: 118471493718016
    m_Localized: "Sana bir devriye yakla\u015F\u0131yor. Onlarla ba\u015Fa \xE7\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 118646492663808
    m_Localized: Devriyeyi yok et
    m_Metadata:
      m_Items: []
  - m_Id: 119030468612096
    m_Localized: "E\u011Fil! Kamyonun yan\u0131nda ne konu\u015Ftuklar\u0131n\u0131
      dinle."
    m_Metadata:
      m_Items: []
  - m_Id: 119835737231360
    m_Localized: "Konu\u015Fmay\u0131 dinlemek"
    m_Metadata:
      m_Items: []
  - m_Id: 120281717575680
    m_Localized: "Her \u015Fey yerine oturdu. Onlarla ilgilen, ard\u0131ndan kamyonlar\u0131
      kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 120499167072256
    m_Localized: "Onlarla ba\u015Fa \xE7\u0131k, sonra kamyonlardaki \u015Feylere
      bak."
    m_Metadata:
      m_Items: []
  - m_Id: 120765144666112
    m_Localized: "Tamam. Kargoyu b\xFCy\xFCk bir hangarda sakl\u0131yorlar. \u0130\xE7eri
      s\u0131z ve bilgiyi bul."
    m_Metadata:
      m_Items: []
  - m_Id: 120958397222912
    m_Localized: "Hangara s\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 121193257275392
    m_Localized: "Uzak b\xFCy\xFCk hangar senin hedefin."
    m_Metadata:
      m_Items: []
  - m_Id: 121560346955776
    m_Localized: "Harika, i\u015Fte anahtar. Hangar\u0131 a\xE7mam\u0131z gerekiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 121812156190720
    m_Localized: "Hangar\u0131n anahtar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 123662838304768
    m_Localized: "i\xE7in topla"
    m_Metadata:
      m_Items: []
  - m_Id: 125434906578944
    m_Localized: "Lanet olsun. Lanet olsun. Kapal\u0131, anahtar bulmal\u0131y\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 125581401034752
    m_Localized: "Anahtar\u0131 bul"
    m_Metadata:
      m_Items: []
  - m_Id: 126758452760576
    m_Localized: "Harika, kap\u0131y\u0131 a\xE7t\u0131n, \u015Fimdi etraf\u0131na
      bak."
    m_Metadata:
      m_Items: []
  - m_Id: 127626568830976
    m_Localized: "Hangar\u0131 incele"
    m_Metadata:
      m_Items: []
  - m_Id: 133907417436160
    m_Localized: "\xD6LD\xDCN!"
    m_Metadata:
      m_Items: []
  - m_Id: 138581495287808
    m_Localized: Bas
    m_Metadata:
      m_Items: []
  - m_Id: 138779835535360
    m_Localized: KULLAN
    m_Metadata:
      m_Items: []
  - m_Id: 138906545459200
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 373388921835520
    m_Localized: Kovalamaca
    m_Metadata:
      m_Items: []
  - m_Id: 373632250187776
    m_Localized: "\u0130stihbarat ekibi, El Kaide'nin kamplar\u0131ndan birinde bilinmeyen
      bir silahla ilerleyen bir koloninin bilgisini ele ge\xE7irdi. Koloniyi ele
      ge\xE7irmek gerekiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 373873162620928
    m_Localized: Arama
    m_Metadata:
      m_Items: []
  - m_Id: 374631702499328
    m_Localized: "Son g\xF6revden elde edilen veriler sayesinde Alkuda liderinin
      bulundu\u011Fu yeri izlemeyi ba\u015Fard\u0131k. Onunla ilgilenme vakti geldi."
    m_Metadata:
      m_Items: []
  - m_Id: 374742306295808
    m_Localized: "S\u0131\xE7an deli\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 374833352052736
    m_Localized: "Her zaman saklanmak m\xFCmk\xFCn de\u011Fil. T\xFCm izler bir yere
      \xE7\u0131k\u0131yor. Da\u011Flar aras\u0131ndaki uzak bir kamp, Alkuda liderinin
      son s\u0131\u011F\u0131na\u011F\u0131. Daha fazla ka\xE7acak yer yok."
    m_Metadata:
      m_Items: []
  - m_Id: 375496601538560
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 375483435618304
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 376121427005440
