    m_Metadata:
      m_Items: []
  - m_Id: 508729964138496
    m_Localized: "Dayan\u0131kl\u0131l\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 524579089715200
    m_Localized: "Alkuda lideri \u015Fehrin kar\u015F\u0131 ucundaki binada olmal\u0131.
      Onu bul."
    m_Metadata:
      m_Items: []
  - m_Id: 524709020864512
    m_Localized: Lideri bul
    m_Metadata:
      m_Items: []
  - m_Id: 524868916121600
    m_Localized: Her yerde devriyeler var, lideri bulmak kolay olmayacak.
    m_Metadata:
      m_Items: []
  - m_Id: 525072725741568
    m_Localized: "O bu binada bir yerde olmal\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 525467653017600
    m_Localized: "Ak\u0131ls\u0131zca, burada de\u011Fil. Nereye ka\xE7t\u0131\u011F\u0131n\u0131
      bulmam\u0131z gerekiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 525589497548800
    m_Localized: Bir iz bul
    m_Metadata:
      m_Items: []
  - m_Id: 525725581742080
    m_Localized: "H\u0131zl\u0131, araca bin."
    m_Metadata:
      m_Items: []
  - m_Id: 525900639408128
    m_Localized: Arabaya bin
    m_Metadata:
      m_Items: []
  - m_Id: 526224523563008
    m_Localized: "Buradan \xE7\u0131kma zaman\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 526678171095040
    m_Localized: "Ha-ha, seni yakalad\u0131m, Boot."
    m_Metadata:
      m_Items: []
  - m_Id: 526870597373952
    m_Localized: Tuzak
    m_Metadata:
      m_Items: []
  - m_Id: 526992634843136
