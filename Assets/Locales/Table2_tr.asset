      m_Items: []
  - m_Id: 504163478573056
    m_Localized: "Varsay\u0131lanlara S\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 105169027895296
    m_Localized: "Boot, neredeyse oras\u0131ndas\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 454779994935296
    m_Localized: "\u0130yile\u015Fmek"
    m_Metadata:
      m_Items: []
