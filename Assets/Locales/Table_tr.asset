  m_TableData:
  - m_Id: 13882413060096
    m_Localized: Kovalamaca
    m_Metadata:
      m_Items:
      - rid: 5573356970983555079
  - m_Id: 22933444268032
    m_Localized: "Ke\u015Fif ekibi, bilinmeyen silahlar\u0131 ta\u015F\u0131yan bir
      kolonun Alkuda'n\u0131n kamplar\u0131ndan birine do\u011Fru yol ald\u0131\u011F\u0131
      bilgisini ele ge\xE7irdi. G\xF6revimiz, kolonu durdurmak ve ta\u015F\u0131nan
      silahlar\u0131 tan\u0131mlamakt\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 23353533173760
    m_Localized: "Ara\u015Ft\u0131rma"
    m_Metadata:
      m_Items: []
  - m_Id: 23931281772544
    m_Localized: "Son g\xF6revden elde edilen veriler sayesinde Alkuda liderinin
      bulundu\u011Fu yeri izlemeyi ba\u015Fard\u0131k. Onunla ilgilenme vakti geldi"
    m_Metadata:
      m_Items: []
  - m_Id: 29742473187328
    m_Localized: "S\u0131\xE7an deli\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 29772571512832
    m_Localized: "Her zaman saklanmak m\xFCmk\xFCn de\u011Fil. T\xFCm izler bir yere
      \xE7\u0131k\u0131yor. Da\u011Flar aras\u0131ndaki uzak bir kamp, Alkuda liderinin
      son s\u0131\u011F\u0131na\u011F\u0131. Daha fazla ka\xE7acak yer yok."
    m_Metadata:
      m_Items: []
  - m_Id: 30533334372352
    m_Localized: Karar
    m_Metadata:
      m_Items: []
  - m_Id: 66403525496832
    m_Localized: Dikey Senkronizasyon
    m_Metadata:
      m_Items: []
